# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Django ---
DJANGO_DEBUG=true
LOCAL_DEMO_MODE=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL). Create the schema first:
#   CREATE DATABASE neural_docs CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_ENGINE=mysql
DB_NAME=neural_docs
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Storage / uploads ---
# MEDIA_ROOT=D:/neural-docs-media
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=50

# --- Celery (leave empty for local demo background processes) ---
CELERY_BROKER_URL=
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# --- Layer 1 preprocessing overrides (all optional) ---
# PREPROCESSING_DENOISER=drunet        # drunet | dncnn | tv | none
# PREPROCESSING_SIGMA_MODE=estimate    # estimate | fixed
# PREPROCESSING_FIXED_SIGMA=0.05
# PREPROCESSING_RENDER_DPI=300
# PREPROCESSING_TILE_SIZE=512
# PREPROCESSING_DEVICE=auto            # auto | cpu | cuda

# --- Nanonets OCR2-3B in Colab. Copy the tunnel URL shown by the notebook. ---
# Example: https://your-random-name.trycloudflare.com/v1
NANONETS_BASE_URL=
# Shared gateway secret generated by the notebook or set in Colab Secrets.
# This is not a Nanonets vendor API key. Never commit the real value.
NANONETS_API_KEY=
NANONETS_MODEL=nanonets/Nanonets-OCR2-3B
NANONETS_TIMEOUT_SECONDS=1800
NANONETS_MAX_TOKENS=8192
